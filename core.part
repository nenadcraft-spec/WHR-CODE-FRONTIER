  const TEAMS = [{ name: 'CYAN', color: '#71e6e6', x: 320, y: 320 }, { name: 'VIOLET', color: '#c7a0ff', x: 2240, y: 320 },
    { name: 'AMBER', color: '#ecc477', x: 320, y: 2240 }, { name: 'CORAL', color: '#fa8e90', x: 2240, y: 2240 }];
  const BUILDINGS = Object.freeze({
