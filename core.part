  function placement(game,owner,type,p,workerId,planning=false,replaceUnitId=null){const d=BUILDINGS[type];if(!d||!p||!Number.isFinite(p.x)||!Number.isFinite(p.y))return{error:'Nevažeća građevina ili lokacija.'};
