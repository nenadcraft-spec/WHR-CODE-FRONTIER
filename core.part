/* WHR CODE FRONTIER · 0.7.0 · T1/T2/T3 local simulation candidate. */
(function (root) {
  'use strict';
  const RULES = Object.freeze({ hz: 20, cell: 16, cols: 160, rows: 160, workerCost: 50, scoutCost: 75,
